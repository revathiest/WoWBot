# ---- Discord ----
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application (client) ID from the same page -> General Information
APPLICATION_ID=
# Optional. When set, slash commands register to this guild only (updates instantly,
# ideal for development). Leave blank to register globally (can take up to an hour).
GUILD_ID=

# When true (the default), EVERY command requires the Manage Server permission,
# including the ones that are normally public. Set to false to hand the commands
# listed in PUBLIC_COMMANDS (config/index.js) back to everybody.
ADMIN_ONLY=true

# ---- Blizzard Battle.net API ----
# Create a client at https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Default region used when a command omits one: us | eu | kr | tw
BLIZZARD_REGION=us
# Response locale, e.g. en_US, en_GB, de_DE, fr_FR, ko_KR, zh_TW
BLIZZARD_LOCALE=en_US

# Default game version used when a command omits one:
#   anniversary - TBC Anniversary (Dreamscythe, Nightslayer, Maladath)
#   retail      - modern WoW
#   classic     - Classic progression (currently Mists of Pandaria)
#   classic-era - permanent vanilla, including Hardcore
BLIZZARD_GAME=retail

# Optional home realm. When set, `realm` becomes an optional command option and
# defaults to this, so your guild never has to type it.
BLIZZARD_REALM=
