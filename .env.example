# ---- Discord ----
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application (client) ID from the same page -> General Information
APPLICATION_ID=
# Optional. When set, slash commands register to this guild only (updates instantly,
# ideal for development). Leave blank to register globally (can take up to an hour).
GUILD_ID=

# When true (the default), EVERY command requires the Manage Server permission,
# including the ones that are normally public. Set to false to hand the commands
# listed in PUBLIC_COMMANDS (config/index.js) back to everybody.
ADMIN_ONLY=true

# ---- Blizzard Battle.net API ----
# Create a client at https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Default region used when a command omits one: us | eu | kr | tw
BLIZZARD_REGION=us
# Response locale, e.g. en_US, en_GB, de_DE, fr_FR, ko_KR, zh_TW
BLIZZARD_LOCALE=en_US

# There is no game-version setting: this bot serves exactly one WoW flavour,
# Classic Forever (patch 1.60.1), and there is no BLIZZARD_REALM either —
# Forever has no realms. Characters are identified by first name and surname;
# guilds and rulesets take the realm's place where the API needs one. /token,
# /arena and /mythicplus do not exist in this bot, because 1.60.1 has no WoW
# Token, no arena, and no Mythic Keystones.

# ---- Namespace watch ----
# Polls the `forever` namespace (Classic Forever) and posts to the channel below
# when an endpoint the bot depends on changes state. This bot's whole feature
# set already relies on the namespace, so what this catches is REGRESSIONS, not
# arrivals. Blizzard has no discovery endpoint, so this tests a fixed list of the
# paths utils/blizzard/ actually calls. See utils/namespaceWatch/checks.js.
NAMESPACE_WATCH=true

# Channel NAME (searched in every guild this instance serves) or a raw channel id.
NAMESPACE_WATCH_CHANNEL=bot-activity-log

# How often to poll, in minutes. Defaults to 360 (six hours); values below 15 are
# raised to 15, since a namespace going live happens on Blizzard's schedule.
NAMESPACE_WATCH_INTERVAL_MINUTES=360

# A real Classic Forever character, as a {name}-{surname} slug, used to check the
# profile API. There is no sensible default: a name nobody owns returns 404 under
# a healthy namespace exactly as it does under a broken one, so an invented
# character would report the profile API as dead. Left empty, that one check is
# reported as skipped rather than guessed at.
#
# Pick one you control — if it is deleted or renamed, the check goes red.
NAMESPACE_WATCH_CHARACTER=
